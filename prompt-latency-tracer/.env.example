# Template — env_bootstrap.py writes a working .env automatically on first run.

# --- LLM (required) ---
# Comma-separate multiple keys in GOOGLE_API_KEY and/or set GOOGLE_API_KEY_2.
# The client auto-rotates when one hits its daily quota.
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_API_KEY_2=optional_second_key_here
MODEL_NAME=gemini-2.5-flash

# --- Local trace output ---
# Spans are written to ./traces/spans.jsonl. Set 1 to also print spans to the console.
OTEL_CONSOLE=0

# --- Server ---
PORT=5000
