# Template only — env_bootstrap.py writes a working .env automatically on first run.

# --- LLM (required) ---
# Multiple keys supported: comma-separate GOOGLE_API_KEY and/or set GOOGLE_API_KEY_2.
# The client auto-rotates to the next key when one hits its daily quota.
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_API_KEY_2=optional_second_key_here
MODEL_NAME=gemini-2.5-flash

# --- Local trace output (default backend) ---
# Spans are always written to ./traces/spans.jsonl. Set 1 to also print to console.
OTEL_CONSOLE=0

# --- Dynatrace OTLP (optional, OFF) ---
# Trace ingest needs a NON-personal API token with scope openTelemetryTrace.ingest.
# Leave disabled until an admin provides one (see README "Enabling Dynatrace").
DYNATRACE_ENABLED=0
DYNATRACE_ENDPOINT=https://YOUR_ENV_ID.live.dynatrace.com/api/v2/otlp
DYNATRACE_API_TOKEN=your_dynatrace_token_here
DYNATRACE_AUTH_SCHEME=Api-Token
